# Optional systemd drop-in: /etc/systemd/system/message-relay.service.d/voice.conf
# Install requirements-voice.txt into a separate Python environment.
# Download the official sherpa-onnx SenseVoice int8 model and tokens first.
[Service]
Environment=MESSAGE_ASR_PYTHON=/opt/message-asr/venv/bin/python
Environment=MESSAGE_ASR_MODEL=/opt/message-asr/models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17/model.int8.onnx
Environment=MESSAGE_ASR_TOKENS=/opt/message-asr/models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17/tokens.txt
Environment=MESSAGE_FFMPEG=/usr/bin/ffmpeg
